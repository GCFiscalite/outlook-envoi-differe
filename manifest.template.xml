<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>f6587219-0f09-4f31-9fb5-6c5123ca2af9</Id>
  <Version>__VERSION__</Version>
  <ProviderName>GC Fiscalite</ProviderName>
  <DefaultLocale>fr-CA</DefaultLocale>
  <DisplayName DefaultValue="Envoi programme"/>
  <Description DefaultValue="Programme l'envoi d'un message cote serveur : Exchange le livre a l'heure choisie meme si Outlook est ferme."/>
  <IconUrl DefaultValue="__BASE__/assets/icone-64.png"/>
  <HighResolutionIconUrl DefaultValue="__BASE__/assets/icone-128.png"/>
  <SupportUrl DefaultValue="https://gcfiscalite.com"/>

  <AppDomains>
    <AppDomain>__BASE__</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="__BASE__/src/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">

      <Requirements>
        <bt:Sets DefaultMinVersion="1.3">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="pageFonctions"/>

            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="grpEnvoiProgramme">
                  <Label resid="grpLabel"/>
                  <Control xsi:type="Button" id="btnEnvoiProgramme">
                    <Label resid="btnLabel"/>
                    <Supertip>
                      <Title resid="btnLabel"/>
                      <Description resid="btnInfo"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icone16"/>
                      <bt:Image size="32" resid="icone32"/>
                      <bt:Image size="80" resid="icone80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="pageVolet"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="icone16" DefaultValue="__BASE__/assets/icone-16.png"/>
          <bt:Image id="icone32" DefaultValue="__BASE__/assets/icone-32.png"/>
          <bt:Image id="icone80" DefaultValue="__BASE__/assets/icone-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="pageVolet" DefaultValue="__BASE__/src/taskpane.html"/>
          <bt:Url id="pageFonctions" DefaultValue="__BASE__/src/fonctions.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="grpLabel" DefaultValue="Envoi programme"/>
          <bt:String id="btnLabel" DefaultValue="Programmer l'envoi"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="btnInfo" DefaultValue="Choisir la date et l'heure de livraison. Exchange envoie le message a l'heure prevue, meme si Outlook est ferme."/>
        </bt:LongStrings>
      </Resources>

    </VersionOverrides>
  </VersionOverrides>

</OfficeApp>
